# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Defaults to a local SQLite file if unset — fine for dev/demo.
# For production, point at Postgres, e.g.:
# DATABASE_URL=postgres://libraryos:libraryos@localhost:5432/libraryos
# DATABASE_URL=sqlite:///db.sqlite3

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / CSRF (comma-separated origins of the frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Misc
TIME_ZONE=UTC
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False
